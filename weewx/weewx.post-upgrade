#!/bin/sh

if [ -f /etc/weewx/weewx.conf.apk-new ]; then
	cat >&2 <<EOF
*
* Your /etc/weewx/weewx.conf was kept. To bring it up to the new version
* (a backup is made first):
*
*   weectl station upgrade --config=/etc/weewx/weewx.conf --what config
*
* then remove /etc/weewx/weewx.conf.apk-new.
*
EOF
fi

cat >&2 <<EOF
*
* Restart WeeWX to use the new version: rc-service weewx restart
*
EOF

exit 0
